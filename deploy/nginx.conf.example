# Example nginx front for a distrans deployment.
#
# This single file mixes http-context directives (limit/conn zones, map,
# upstream, gzip) with the server block, so include it from the http {} context
# (sites-enabled/ or conf.d/). Replace every <...> placeholder.

# The backend does not rate-limit and does not parse X-Forwarded-For, so this
# edge is the only limiter. Keep these rates and the per-location bursts in
# sync with the app's own limits (GET /api/limits).
#
# `rate` is the sustained leaky-bucket drain rate, `burst` is what may be
# accepted on top of it *at once*. They are not interchangeable: a page load
# fires a whole batch of requests within milliseconds, and anything above
# `burst` in that instant is rejected with 429 regardless of how low the
# average rate is. Size every burst for one full page load, not one click.

# Empty key = not accounted, so `writes` only limits mutating requests while
# the same location still serves reads from `general`.
map $request_method $write_client {
    default $binary_remote_addr;
    GET     "";
    HEAD    "";
}

# Same trick for the image endpoints: only reads use the generous `media`
# bucket, while PUT/DELETE on the very same path fall through to `writes`.
map $request_method $media_client {
    default "";
    GET     $binary_remote_addr;
    HEAD    $binary_remote_addr;
}

limit_req_zone $binary_remote_addr zone=general:8m    rate=120r/s;
limit_req_zone $media_client        zone=media:16m    rate=600r/s;
limit_req_zone $binary_remote_addr zone=creating:8m   rate=5r/s;
limit_req_zone $binary_remote_addr zone=restricted:8m rate=5r/s;
limit_req_zone $write_client        zone=writes:8m    rate=5r/s;
limit_req_zone $binary_remote_addr zone=search:8m     rate=2r/s;
limit_req_status 429;
limit_req_log_level warn;

# Set `perip` above the number of sockets a single real client needs — the app
# also holds WebSockets — and raise it if users share a NAT/CGNAT address.
limit_conn_zone $binary_remote_addr zone=perip:8m;
limit_conn_zone $server_name zone=perserver:8m;
limit_conn perip 200;
limit_conn perserver 20000;
limit_conn_status 429;
limit_conn_log_level warn;

client_body_timeout 10s;
client_header_timeout 10s;
keepalive_timeout 5s;
send_timeout 10s;

server_tokens off;
autoindex off;

proxy_hide_header X-Powered-By;
proxy_hide_header Server;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_vary on;
gzip_types text/plain text/css text/javascript application/javascript
           application/json application/xml image/svg+xml;

upstream distrans {
    server unix:/run/distrans/api.sock;

    # Reuse backend connections; this requires `proxy_set_header Connection ""`
    # on every non-WS proxy location below. The gateway must NOT use it.
    keepalive 32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Edge cache for hash-addressed images (emoji icons and avatars). Their URL
# carries the content hash, so a hit can never be stale: a changed image gets a
# new URL. The backend marks them `private, immutable`, which only means "do
# not put this in a shared cache"; the media locations below override that for
# this cache on purpose, otherwise every page load turns into one Postgres read
# per image.
#
# This is a plain directory on the host's filesystem, nginx
# creates it on start and must be able to write there, e.g. as the nginx user:
#   install -d -o nginx -g nginx /var/cache/nginx/distrans-media
# Give it enough disk for the icons/avatars served within `inactive`.
proxy_cache_path /var/cache/nginx/distrans-media levels=1:2 keys_zone=media_cache:16m
                 max_size=2g inactive=30d use_temp_path=off;

server {
    listen 443 ssl;
    http2 on; # nginx < 1.25.1: use `listen 443 ssl http2;` instead.
    server_name <chat.example.com>;

    ssl_certificate     <path/to/fullchain.pem>;
    ssl_certificate_key <path/to/privkey.pem>;

    charset utf-8;

    # Static SPA bundle.
    root <path/to/dist>;
    index index.html;

    # Must be >= files.max_size (src/config.zig), otherwise this edge rejects
    # uploads before the backend can answer 413 itself.
    client_max_body_size 8m;

    # If a CDN/proxy sits in front, whitelist it so $binary_remote_addr is the
    # real client and not the proxy; otherwise every client shares one bucket.
    # set_real_ip_from <proxy-cidr>;
    # real_ip_header <CF-Connecting-IP|X-Forwarded-For>;

    # Origins the SPA may load images/media from: the union of the backend's
    # files.public_base_urls (GET /api/limits) and the frontend allowlist in
    # distrans-ui/src/utils/media.ts. Keep the CSP below in sync with both.
    # Passthrough uploads keep their client Content-Type, so the files origin
    # itself must also serve objects with nosniff + a sandbox CSP.
    set $files_origin "<https://files.example.com> <https://cdn.example.com>";

    # Served with the HTML document; API JSON never carries it. add_header is
    # not inherited once a child block declares one, so any location that adds
    # its own header must re-declare this whole block.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: $files_origin; media-src 'self' $files_origin; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;

    # Vite emits content-hashed filenames here. `expires` sets Cache-Control
    # without resetting the inherited headers above, unlike add_header.
    location /assets/ {
        expires 1y;
        access_log off;
        try_files $uri =404;
    }

    # App shell (and root files): always revalidate.
    location / {
        limit_req zone=general burst=50 nodelay;

        try_files $uri $uri/ /index.html;

        expires -1;
    }

    # Hash-addressed images: GET /api/emojis/{id}/icon?hash=… and
    # GET /api/{users|guilds|webhooks}/{id}/avatar?hash=… . Public, cheap and
    # immutable, but a page load can request hundreds of them at once (every
    # custom emoji in every visible guild). They therefore get their own zone
    # and a burst large enough for a full load, so they neither 429 nor drain
    # the `general` bucket shared with /api/gateway and regular API calls.
    #
    # PUT on these same paths re-encodes an image and is expensive, so it is
    # handled by `writes` (empty `media` key) instead of the media burst.
    #
    # `proxy_ignore_headers Cache-Control` overrides the backend's `private`
    # marker so the edge cache can absorb the burst; that is safe here because
    # the hash in the URL changes whenever the image changes.
    location ~ ^/api/emojis/[0-9]+/icon$ {
        limit_req zone=media burst=400 nodelay;
        limit_req zone=writes burst=5 nodelay;

        proxy_cache media_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_valid 200 365d;
        proxy_cache_lock on;
        proxy_cache_lock_age 10s;
        proxy_cache_use_stale updating error timeout;
        proxy_ignore_headers Cache-Control;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        access_log off;
    }

    location ~ ^/api/(users|guilds|webhooks)/[0-9]+/avatar$ {
        limit_req zone=media burst=200 nodelay;
        limit_req zone=writes burst=5 nodelay;

        proxy_cache media_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_valid 200 365d;
        proxy_cache_lock on;
        proxy_cache_lock_age 10s;
        proxy_cache_use_stale updating error timeout;
        proxy_ignore_headers Cache-Control;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        access_log off;
    }

    location /api {
        limit_req zone=general burst=60 nodelay;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # File upload: expensive (decode + re-encode + S3 PUT).
    location = /api/files {
        limit_req zone=restricted burst=3 nodelay;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Channel messages: GET lists history, POST creates one. Reads are cheap and
    # happen on every channel switch, so they stay on `general`; the write
    # limiter applies to mutating methods only through the `writes` zone.
    location ~ ^/api/channels/[0-9]+/messages$ {
        limit_req zone=general burst=40 nodelay;
        limit_req zone=writes burst=5 nodelay;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Single message: GET reads it, PATCH/DELETE edit or remove it (mass content
    # removal is the expensive/abusable part, hence the write limiter).
    location ~ ^/api/messages/[0-9]+$ {
        limit_req zone=general burst=20 nodelay;
        limit_req zone=writes burst=5 nodelay;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Auth and system endpoints.
    location /api/auth {
        limit_req zone=creating burst=5 nodelay;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/system {
        limit_req zone=creating burst=5 nodelay;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Clients fetch file origins and limits here.
    location /api/limits {
        limit_req zone=general burst=40 nodelay;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Full-text message search: heavy Postgres (trigram) query.
    location ~ ^/api/guilds/[0-9]+/messages/search$ {
        limit_req zone=search burst=5 nodelay;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Webhook execute: token-authenticated, no session, creates a message.
    # The negative lookahead keeps the reserved /avatar subpath (webhook
    # management) out of this zone. CI/integration senders legitimately fire
    # several events in one go, so the burst is wider than for a human action.
    location ~ ^/api/webhooks/[0-9]+/(?!avatar$)[^/]+(/github)?$ {
        limit_req zone=restricted burst=20 nodelay;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Delta sync (changed-since). Polled on reconnect/focus only, so the rate
    # stays low, but one reconnect fires all of them and every open tab repeats
    # it, hence the wider burst. The `$` anchors keep these from colliding with
    # the existing message endpoints above.
    location ~ ^/api/guilds/[0-9]+/sync$ {
        limit_req zone=restricted burst=10 nodelay;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/api/channels/[0-9]+/messages/sync$ {
        limit_req zone=restricted burst=10 nodelay;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/users/sync {
        limit_req zone=restricted burst=10 nodelay;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket gateway. Connection here comes from the map, not "". The burst
    # covers reconnect storms (many tabs, network flaps) without touching the
    # long-lived connection itself.
    location /api/gateway {
        limit_req zone=general burst=20 nodelay;

        proxy_pass http://distrans;
        proxy_http_version 1.1;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }
}

server {
    listen 80;
    server_name <chat.example.com>;

    return 301 https://$host$request_uri;
}
